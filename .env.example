# ─── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. On Vercel, adding Neon from the Storage tab sets these for you.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional: a direct (non-pooled) URL used only for migrations. Neon provides this automatically.
DATABASE_URL_UNPOOLED=

# Your public site address, no trailing slash. QR codes point here, so set it before issuing.
APP_URL=https://your-domain.com

# Generate all four with:  npm run keys:generate
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
SECRET_SALT=

# Protects the daily cleanup job. Any long random string.
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────

# Email (resend.com). Without these, accounts skip email confirmation and
# password-reset links are only printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="Attesta <no-reply@your-domain.com>"
# Where mail is posted. Leave unset to use Resend; the end-to-end tests point it at a stand-in server.
# RESEND_API_URL=

# Sign in with Google. With both set, the sign-in and sign-up pages offer "Continue with Google".
# Create a "Web application" client in the Google Cloud console (Google Auth platform > Clients) and add
# <APP_URL>/api/auth/google/callback to its authorised redirect URIs. See the README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where to send people and trade codes. Leave unset to use Google; the end-to-end tests point them at a stand-in.
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=

# Online payment through SSLCommerz: card, bKash, Nagad, Rocket and internet banking on SSLCommerz's page, with
# credits added automatically. With both set, the billing page offers "Pay online". Start with a sandbox store
# (developer.sslcommerz.com/registration); set SSLCOMMERZ_LIVE=true only with a live store's values. See the README.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_LIVE=
# Where SSLCommerz is. Leave unset; the end-to-end tests point it at a stand-in.
# SSLCOMMERZ_API_URL=

# Google AdSense publisher ID (ca-pub-...). Ads appear only on public pages.
NEXT_PUBLIC_ADSENSE_CLIENT=

# After rotating signing keys, keep old public keys here so older certificates still verify.
# SIGNING_PUBLIC_KEYS_OLD={"k20260101":"MCowBQYDK2VwAyEA..."}
